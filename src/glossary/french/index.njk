---
layout: layouts/french-index.njk
title: french
---

  <p> a place to practice french – taken from "Chez Nous" (2020).

  <div class="unit-grid">
    {% for unit in units %}
      <div class="unit">
        <p>
        {% if unit.isMisc %}my misc &nbsp;{% else %}chapitre {{ unit.id }}{% endif %}
        <button data-unit="{{ unit.id }}" data-mode="vocab">vocab</button>
        <button data-unit="{{ unit.id }}" data-mode="grammar">grammar</button>
        <button data-unit="{{ unit.id }}" data-mode="both">both</button></p>
      </div>

      <div class="practice-area" id="practice-{{ unit.id }}"></div>
    </div>
    {% endfor %}
  </div>

<script id="french-data" type="application/json">
    {{ units | dump | safe }}
</script>